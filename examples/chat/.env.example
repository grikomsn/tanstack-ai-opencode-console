# Server-only configuration. Never use a VITE_ prefix for your key.
OPENCODE_API_KEY=
# OPENCODE_BASE_URL=https://opencode.ai/inference
# OPENCODE_MODEL=
# Optional comma-separated subset of the discovered model IDs.
# OPENCODE_ALLOWED_MODELS=

# Vercel only: encrypted per-visitor Console sessions. See ../../docs/vercel.md.
# Set these in Vercel environment variables; the local Node server ignores them.
# Vercel Marketplace also supplies KV_REST_API_URL and KV_REST_API_TOKEN.
# UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
# UPSTASH_REDIS_REST_TOKEN=
# OPENCODE_SESSION_SECRET= # 64 hex characters from openssl rand -hex 32
# OPENCODE_SESSION_PREFIX=tanstack-opencode:production
# OPENCODE_ALLOWED_ORIGINS=https://chat.example.com
