{
  "name": "@opencode-console/chat-example",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently --kill-others --success first \"npm run server\" \"vite\"",
    "server": "node --env-file-if-exists=../../.env --env-file-if-exists=.env --import tsx server.ts",
    "build": "vite build",
    "preview": "concurrently --kill-others --success first \"npm run server\" \"vite preview\"",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@tanstack/ai": "0.65.0",
    "@tanstack/ai-react": "0.29.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tanstack-ai-opencode-console": "0.1.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "concurrently": "10.0.5",
    "vite": "8.3.3"
  }
}
